# Server-side only — used by api/contact.js. Never prefix these for the browser.
# Production: set both in Vercel -> Project -> Settings -> Environment Variables
# (Production and Preview), then redeploy. Local: copy to .env.local (git-ignored).

# Google Apps Script web app deployment URL (Deploy -> Manage deployments)
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec

# Random shared secret; must equal the secret configured in the Apps Script.
# Not the Gmail password.
GOOGLE_APPS_SCRIPT_SECRET=REPLACE_WITH_SECRET
